.{
    // This is the default name used by packages depending on this one. For
    // example, when a user runs `zig fetch --save <url>`, this field is used
    // as the key in the `dependencies` table. Although the user can choose a
    // different name, most users will stick with this provided value.
    //
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .aion,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "0.0.5",
    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*. This allows
    // unambiguous detection of one package being an updated version of
    // another.
    //
    // When forking a Zig project, this id should be regenerated (delete the
    // field and run `zig build`) if the upstream project is still maintained.
    // Otherwise, the fork is *hostile*, attempting to take control over the
    // original project's identity. Thus it is recommended to leave the comment
    // on the following line intact, so that it shows up in code reviews that
    // modify the field.
    .fingerprint = 0xadb784e22824f161, // Changing this has security and trust implications.
    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.18.0-dev.1180+2e9bb03df",
    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    // Prebuilt wgpu-native (WebGPU) binaries, one per platform. All lazy: only
    // the archive matching the build target is fetched (see `wgpuDependency` in
    // build.zig). Bump the tag + re-run `zig fetch --save=<name> <url>` to update.
    .dependencies = .{
        // Fork build: upstream trunk (which has gfx-rs/wgpu-native#619, memory_hints:
        // ~250 MiB less committed VRAM per device) + gfx-rs/wgpu-native#642
        // (experimentalFeaturesEnabled: lets the device request cooperative
        // matrices) + gfx-rs/wgpu-native#643 (wgpuAdapterGetCooperativeMatrixProperties:
        // which matrix configurations the adapter has). Restore the official URLs
        // once upstream ships a release containing all three.
        //
        // BEFORE MOVING TO wgpu >= 30: these binaries carry naga 29.0.4, whose
        // Metal writer inverts cooperative-matrix load/store layouts (fixed in
        // wgpu 30, gfx-rs/wgpu#9451). The Apple 8x8 f32 kernels rely on the
        // inversion: matmul_q8_mx.wgsl, attention_mx.wgsl, codegen.zig
        // `matrixBody` (and their exec/ generators) must swap every
        // coopLoad <-> coopLoadT and coopStore <-> coopStoreT in the same change,
        // verified on Apple silicon. The _mx16 (NVIDIA) kernels already follow the
        // spec. Also check whether gfx-rs/wgpu#10901 (coopStore stride emitted
        // late) has landed; the kernels bind strides to `let`s to work around it.
        .wgpu_windows_x86_64 = .{
            .url = "https://github.com/RubyBit/wgpu-native/releases/download/v29.0.4-experimental.2/wgpu-windows-x86_64-msvc-release.zip",
            .hash = "N-V-__8AAJVEKgIp09B6nvZ0ImtxFRCRvHsWoNDXAEUoILiK",
            .lazy = true,
        },
        .wgpu_linux_x86_64 = .{
            .url = "https://github.com/RubyBit/wgpu-native/releases/download/v29.0.4-experimental.2/wgpu-linux-x86_64-release.zip",
            .hash = "N-V-__8AAFDmxgHOfEHXm10Nn3uEvHrMc3zggpHtKtchBm1M",
            .lazy = true,
        },
        .wgpu_linux_aarch64 = .{
            .url = "https://github.com/RubyBit/wgpu-native/releases/download/v29.0.4-experimental.2/wgpu-linux-aarch64-release.zip",
            .hash = "N-V-__8AALQ_xwFdLE2WXeRNJzUXmAjXGE0Th92TVGy-rQMf",
            .lazy = true,
        },
        .wgpu_macos_aarch64 = .{
            .url = "https://github.com/RubyBit/wgpu-native/releases/download/v29.0.4-experimental.2/wgpu-macos-aarch64-release.zip",
            .hash = "N-V-__8AAIi0KwGBeNuL-f7QYx0VSMFRHL7wEVQ_5-gE5p3m",
            .lazy = true,
        },
        .wgpu_macos_x86_64 = .{
            .url = "https://github.com/RubyBit/wgpu-native/releases/download/v29.0.4-experimental.2/wgpu-macos-x86_64-release.zip",
            .hash = "N-V-__8AANCrLQHYStZm53ZqbLvG9sRSR8zMRm7Lxh4y69-u",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // For example...
        //"LICENSE",
        //"README.md",
    },
}
